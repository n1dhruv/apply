# Copy to .env and fill in
# --- LLM via LiteLLM proxy (Gemini free tier by default) ---
# 1) pip install litellm, set GEMINI_API_KEY below (free: https://aistudio.google.com/apikey)
# 2) litellm --config litellm-config.yaml --port 4000
# 3) set LLM_MODEL + LLM_API_KEY (= LITELLM_MASTER_KEY) below
GEMINI_API_KEY=
LITELLM_MASTER_KEY=sk-local-123
LLM_BASE_URL=http://localhost:4000
LLM_API_KEY=sk-local-123
LLM_MODEL=gemini-flash
# Without these, the app runs in mock mode (deterministic, offline).

# --- Scraping (public data only) ---
# Hosted scraping provider (Apify or equivalent).
APIFY_TOKEN=
DATABASE_URL="postgresql://user:password@localhost:5432/dating?schema=public"
DEMO_MODE=true
